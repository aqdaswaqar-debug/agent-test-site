{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run lint *)",
      "Bash(npx eslint *)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx tsc --noEmit *)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run dev *)",
      "Bash(npm audit)",
      "Bash(npm ls *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git checkout staging-2)",
      "Bash(git switch staging-2)",
      "Bash(git pull origin staging-2)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git revert *)",
      "Bash(git push origin staging-2)",
      "Bash(git push -u origin staging-2)"
    ],
    "ask": [
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm add *)",
      "Bash(npm remove *)",
      "Bash(npm uninstall *)",
      "Bash(npm update *)",
      "Bash(npx create-*)",
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Edit(/app/layout.tsx)",
      "Edit(/app/globals.css)",
      "Edit(/next.config.ts)",
      "Edit(/tsconfig.json)",
      "Edit(/eslint.config.mjs)",
      "Edit(/postcss.config.mjs)",
      "Edit(/package.json)",
      "Edit(/docs/**)",
      "Edit(/.claude/**)",
      "Edit(/.github/**)",
      "Write(/app/layout.tsx)",
      "Write(/app/globals.css)",
      "Write(/next.config.ts)",
      "Write(/tsconfig.json)",
      "Write(/eslint.config.mjs)",
      "Write(/postcss.config.mjs)",
      "Write(/package.json)",
      "Write(/docs/**)",
      "Write(/.claude/**)",
      "Write(/.github/**)"
    ],
    "deny": [
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push origin staging)",
      "Bash(git push origin staging *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git branch -D *)",
      "Bash(git rebase *)",
      "Bash(rm -rf *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Edit(/package-lock.json)",
      "Write(/package-lock.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.mjs\""
          }
        ]
      }
    ]
  }
}
