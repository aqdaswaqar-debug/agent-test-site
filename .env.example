# Variable names only. Never put real values in this file or in code.
# Real (fake/test) values live in .env.local, which is never committed or read by the agent.

# Mock lead-form endpoint / test service key (fake)
MOCK_API_KEY=

# Public site URL used for canonical links and JSON-LD
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# VERCEL_PROJECT_PRODUCTION_URL is set automatically by Vercel (system env, no value needed here).
# lib/site.ts uses it as the fallback for NEXT_PUBLIC_SITE_URL.
